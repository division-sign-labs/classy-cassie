{
  "name": "@quotient-forecasting/cassie",
  "version": "0.4.1",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Self-hosted, non-custodial trading bots for prediction markets and perps venues",
  "keywords": [
    "polymarket",
    "kalshi",
    "hyperliquid",
    "prediction-markets",
    "perps",
    "trading-bot",
    "non-custodial",
    "self-hosted",
    "cli",
    "digitalocean"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quotient-Solutions-Inc/classy-cassie.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Quotient-Solutions-Inc/classy-cassie#readme",
  "bugs": {
    "url": "https://github.com/Quotient-Solutions-Inc/classy-cassie/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "cassie": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/index.js",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "@quotient-forecasting/cassie-core": "workspace:*",
    "@quotient-forecasting/cassie-runtime-node": "workspace:*",
    "@quotient-forecasting/cassie-skill": "workspace:*",
    "@quotient-forecasting/strategy-agent": "workspace:*",
    "@quotient-forecasting/strategy-market-make": "workspace:*",
    "commander": "15.0.0",
    "picocolors": "1.1.1",
    "prompts": "2.4.2"
  },
  "devDependencies": {
    "@types/node": "24.2.1",
    "@types/prompts": "2.4.9",
    "typescript": "5.9.2"
  }
}
