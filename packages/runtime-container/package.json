{
  "name": "@quotient-forecasting/cassie-runtime-container",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Long-running Cloudflare Container runtime for Cassie trading bots",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quotient-Solutions-Inc/classy-cassie.git",
    "directory": "packages/runtime-container"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@quotient-forecasting/cassie-core": "workspace:*",
    "@quotient-forecasting/strategy-flip-flat": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.2.1",
    "typescript": "5.9.2"
  }
}
