{
  "name": "@quotient-forecasting/cassie-runtime-node",
  "version": "0.4.3",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Node runtime for Cassie trading bots: engine loop, SQLite state, and a unix-socket control API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quotient-Solutions-Inc/classy-cassie.git",
    "directory": "packages/runtime-node"
  },
  "homepage": "https://github.com/Quotient-Solutions-Inc/classy-cassie/tree/main/packages/runtime-node#readme",
  "bugs": {
    "url": "https://github.com/Quotient-Solutions-Inc/classy-cassie/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "cassie-runtime": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@quotient-forecasting/cassie-core": "workspace:*",
    "@quotient-forecasting/strategy-agent": "workspace:*",
    "@quotient-forecasting/strategy-flip-flat": "workspace:*",
    "@quotient-forecasting/strategy-market-make": "workspace:*",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.2.1",
    "typescript": "5.9.2"
  }
}
