{
  "name": "@quotient-forecasting/cassie-runtime-cf",
  "version": "0.1.1",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Cloudflare Worker control plane and deployment assets for Cassie Containers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quotient-Solutions-Inc/classy-cassie.git",
    "directory": "packages/runtime-cf"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "Dockerfile",
    "Dockerfile.package",
    "wrangler.jsonc",
    "wrangler.package.jsonc",
    "worker-configuration.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cf-types": "wrangler types",
    "deploy": "wrangler deploy --containers-rollout=immediate"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@quotient-forecasting/cassie-core": "workspace:*",
    "@quotient-forecasting/cassie-runtime-container": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "wrangler": "4.123.0"
  }
}
