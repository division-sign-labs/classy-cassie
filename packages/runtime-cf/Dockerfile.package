# packages/runtime-cf/Dockerfile.package
FROM --platform=linux/amd64 node:24-bookworm-slim

ARG CASSIE_RUNTIME_VERSION=0.1.0
ENV NODE_ENV=production
WORKDIR /app

RUN npm install --omit=dev --ignore-scripts --no-audit --no-fund \
    "@quotient-forecasting/cassie-runtime-container@${CASSIE_RUNTIME_VERSION}"

USER node
EXPOSE 8080
CMD ["node", "node_modules/@quotient-forecasting/cassie-runtime-container/dist/index.js"]
