{
  "name": "cassie-monorepo",
  "private": true,
  "version": "0.4.3",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "release:check": "pnpm typecheck && pnpm test && node scripts/release.mjs --dry-run",
    "release:publish": "pnpm release:check && node scripts/release.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "@types/node": "24.2.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
